<Window x:Class="VectorPilot.App.Controls.PostManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Post Processors" Width="560" Height="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="PostList"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Name" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtName" Width="140" Margin="6,0,0,0"/>
            <TextBlock Text="Version" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="TxtVersion" Width="70" Margin="6,0,0,0"/>
            <Button Content="Install/Update" Margin="10,0,0,0" Padding="8,4" Click="Install_Click"/>
            <Button Content="Remove" Margin="6,0,0,0" Padding="8,4" Click="Remove_Click"/>
        </StackPanel>
    </Grid>
</Window>
