<UserControl x:Class="VectorPilot.App.Controls.DocumentVariablesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Document Variables" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Named values and driven dimensions (SPK-0512)." Foreground="#666"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="LstVariables" Grid.Column="0" DisplayMemberPath="Key"
                     SelectionChanged="LstVariables_SelectionChanged"/>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Key" FontSize="11" Foreground="#555"/>
                <TextBox x:Name="TxtKey" Margin="0,2,0,8" LostFocus="EditBox_LostFocus"/>
                <TextBlock Text="Value" FontSize="11" Foreground="#555"/>
                <TextBox x:Name="TxtValue" Margin="0,2,0,8" LostFocus="EditBox_LostFocus"/>
                <TextBlock Text="Category" FontSize="11" Foreground="#555"/>
                <TextBox x:Name="TxtCategory" Margin="0,2,0,12" LostFocus="EditBox_LostFocus"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnAdd" Content="Add Variable" Padding="10,6" Click="BtnAdd_Click"/>
                    <Button x:Name="BtnDelete" Content="Delete" Padding="10,6" Margin="8,0,0,0" Click="BtnDelete_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Driven Dimensions" FontWeight="SemiBold"/>
            <TextBlock Text="Expression preview resolves live — green when valid, red when not." Foreground="#666" FontSize="11" Margin="0,2,0,8"/>
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LstDimensions"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
