<UserControl x:Class="VectorPilot.App.Controls.CutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Toolpaths" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Add a strategy, then calculate — the G-code appears below and is ready for the Machine stage." 
                   Foreground="#666" Margin="0,2,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox x:Name="CmbStrategy" Width="200" ToolTip="Every registered strategy">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox x:Name="TxtDepth" Text="0.25" Width="70" Margin="8,0,0,0" ToolTip="Cut depth"/>
            <TextBox x:Name="TxtFeed" Text="100" Width="60" Margin="6,0,0,0" ToolTip="Feed rate"/>
            <TextBlock Text="Tabs:" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555"/>
            <TextBox x:Name="TxtTabCount" Text="0" Width="32" Margin="4,0,0,0"
                     ToolTip="Holding tabs around a profile — 0 for none. The part falls loose without them."/>
            <Button x:Name="BtnAdd" Content="+ Add Toolpath" Margin="10,0,0,0" Padding="12,6" Click="BtnAdd_Click"/>
            <Button x:Name="BtnCalc" Content="Calculate All" Margin="8,0,0,0" Padding="12,6" Click="BtnCalc_Click"/>
            <Button x:Name="BtnSend" Content="→ Machine" Margin="8,0,0,0" Padding="12,6" Click="BtnSend_Click"/>
            <Button x:Name="BtnSort" Content="Sort by Tool" Margin="8,0,0,0" Padding="12,6" Click="Sort_Click"/>
            <Button x:Name="BtnRecalcDirty" Content="Recalc Dirty" Margin="8,0,0,0" Padding="12,6" Click="RecalcDirty_Click"/>
            <Separator Margin="10,0" Width="1" Background="#CCC"/>
            <!-- Array copy: ArrayCopyEngine shipped with zero app call-sites. Creates a
                 NEW toolpath, so the original is never destroyed. -->
            <ComboBox x:Name="CmbArrayType" Width="76" Height="24" SelectedIndex="0"
                      ToolTip="Array pattern">
                <ComboBoxItem Content="Linear"/>
                <ComboBoxItem Content="Grid"/>
                <ComboBoxItem Content="Circular"/>
            </ComboBox>
            <TextBox x:Name="TxtArrayCount" Width="34" Height="24" Margin="4,0,0,0" Text="3"
                     ToolTip="Copies (or columns for a grid)"/>
            <TextBox x:Name="TxtArraySpacing" Width="44" Height="24" Margin="4,0,0,0" Text="50"
                     ToolTip="Spacing in mm — circle radius for a circular array"/>
            <TextBox x:Name="TxtArrayRows" Width="32" Height="24" Margin="4,0,0,0" Text="2"
                     ToolTip="Grid rows (grid only)"/>
            <Button x:Name="BtnArray" Content="Array copy" Margin="6,0,0,0" Padding="10,6"
                    Click="ArrayCopy_Click"
                    ToolTip="Add a NEW toolpath repeating the selected one (original kept)"/>
            <Separator Margin="10,0" Width="1" Background="#CCC"/>
            <!-- Toolpath templates: ToolpathTemplateManager had zero app call-sites. -->
            <ComboBox x:Name="CmbTemplate" Width="130" Height="24" DisplayMemberPath="Name"
                      ToolTip="Saved parameter templates for this strategy"/>
            <Button x:Name="BtnApplyTemplate" Content="Apply" Margin="4,0,0,0" Padding="8,6"
                    Click="ApplyTemplate_Click"
                    ToolTip="Overwrite the selected toolpath's params with this template"/>
            <Button x:Name="BtnSaveTemplate" Content="Save as…" Margin="4,0,0,0" Padding="8,6"
                    Click="SaveTemplate_Click"
                    ToolTip="Save the selected toolpath's current params as a named template"/>
            <Button x:Name="BtnMerge" Content="Merge all" Margin="6,0,0,0" Padding="8,6"
                    Click="Merge_Click"
                    ToolTip="Combine every calculated toolpath into ONE program, ordered by tool (originals kept)"/>
        </StackPanel>

        <ListBox x:Name="ToolpathList" Grid.Row="2" Margin="0,4,0,0" SelectionChanged="ToolpathList_SelectionChanged"/>
        <TextBlock x:Name="CalcNote" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,4,0" FontSize="11" Foreground="#B22" TextWrapping="Wrap" MaxWidth="320"
                   Visibility="Collapsed"/>
        <TextBlock x:Name="SourceLinkLabel" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   Margin="0,0,8,-16" FontSize="11" Foreground="DimGray"/>
        <Border Grid.Row="3" Background="#F4F4F6" BorderBrush="#CCC" BorderThickness="1" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Params:" VerticalAlignment="Center"/>
                <ItemsControl x:Name="ParamsGrid" Margin="8,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Key}" VerticalAlignment="Center" MinWidth="90"/>
                                <TextBox Text="{Binding Text, Mode=TwoWay}" Width="110" VerticalAlignment="Center"
                                         ToolTip="Expressions allowed: 2440/2, $width/2"
                                         Visibility="{Binding IsFreeText, Converter={StaticResource BoolToVis}}"/>
                                <ComboBox SelectedItem="{Binding Text, Mode=TwoWay}" ItemsSource="{Binding Choices}"
                                          Width="130" VerticalAlignment="Center"
                                          Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="(expressions allowed)" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="#22222C" CornerRadius="6" Padding="10" MaxHeight="220">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Generated G-code (first 60 lines)" Foreground="#9AC8FF" FontSize="11" Margin="0,0,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="GCodePreview" FontFamily="Consolas" FontSize="11" Foreground="#DDD" Text="— nothing calculated yet —"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
