<UserControl x:Class="VectorPilot.App.Controls.ModelPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VectorPilot.App.Controls">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="6,4,6,12">
            <TextBlock Text="3D Model" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="Build a relief from components. Each component combines into the composite below it."
                       Foreground="#777" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnImportRelief" Content="Import heightfield…" Height="26" Padding="10,0"
                        Click="ImportRelief_Click" ToolTip="STL / OBJ / 3MF / bitmap → relief component"/>
                <Button x:Name="BtnAddShape" Content="Add shape relief" Height="26" Padding="10,0" Margin="6,0,0,0"
                        Click="AddShape_Click" ToolTip="Dome / round / ramp primitive"/>
                <Button x:Name="BtnAddWeave" Content="Add weave" Height="26" Padding="10,0" Margin="6,0,0,0"
                        Click="AddWeave_Click" ToolTip="Interlaced woven surface (plain / twill / satin)"/>
                <ComboBox x:Name="CmbWeavePattern" Width="86" Height="26" Margin="4,0,0,0"
                          ToolTip="Weave pattern"/>
                <Button x:Name="BtnBake" Content="Bake to job" Height="26" Padding="10,0" Margin="6,0,0,0"
                        Click="Bake_Click" ToolTip="Send the composite to the Toolpaths stage"/>
                <TextBlock x:Name="StatusLabel" Foreground="#555" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBlock Text="Offset mm:" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#555"/>
                <TextBox x:Name="TxtModelOffset" Width="44" Height="24" Margin="4,0,0,0" Text="1.0"
                         ToolTip="Raise (+) or lower (−) the whole relief by this many mm"/>
                <Button x:Name="BtnModelOffset" Content="Apply offset" Width="86" Height="24" Margin="4,0,0,0"
                        Click="ModelOffset_Click"
                        ToolTip="Inflate or deflate the composite relief (undoable)"/>
                <Button x:Name="BtnModelOffsetUndo" Content="Undo offset" Width="80" Height="24" Margin="4,0,0,0"
                        Click="ModelOffsetUndo_Click" IsEnabled="False"
                        ToolTip="Restore the relief to before the last offset"/>
                <Button x:Name="BtnSculptUndo" Content="Undo stroke" Width="84" Height="24" Margin="4,0,0,0"
                        Click="SculptUndo_Click" IsEnabled="False"
                        ToolTip="Restore the selected component to before the last sculpt stroke (drag on the 3D view to sculpt)"/>
            </StackPanel>

            <!-- Animated camera (animated camera): the preview previously had a
                 manual nudge-rotate only. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="View:" VerticalAlignment="Center" Foreground="#555"/>
                <Button x:Name="BtnViewIso" Content="Iso" Width="46" Height="24" Margin="6,0,0,0"
                        Click="ViewIso_Click" ToolTip="Ease the camera to an isometric view"/>
                <Button x:Name="BtnViewTop" Content="Top" Width="46" Height="24" Margin="4,0,0,0"
                        Click="ViewTop_Click" ToolTip="Ease the camera to look straight down"/>
                <Button x:Name="BtnViewFront" Content="Front" Width="52" Height="24" Margin="4,0,0,0"
                        Click="ViewFront_Click"/>
                <Button x:Name="BtnViewRight" Content="Right" Width="52" Height="24" Margin="4,0,0,0"
                        Click="ViewRight_Click"/>
                <Button x:Name="BtnOrbit" Content="▶ Orbit" Width="76" Height="24" Margin="10,0,0,0"
                        Click="Orbit_Click" ToolTip="Animate a continuous camera orbit"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" Margin="6,0,6,6">
            <Grid>
                <c:ThreeDPreview x:Name="View3D"/>
                <TextBlock x:Name="EmptyHint" Text="No components yet — import a heightfield or add a shape relief."
                           Foreground="#999" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,6,6">
            <c:ComponentTreePanel x:Name="Tree"/>
        </Border>
    </Grid>
</UserControl>
