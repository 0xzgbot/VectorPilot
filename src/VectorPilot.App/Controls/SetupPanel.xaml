<UserControl x:Class="VectorPilot.App.Controls.SetupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Job Setup" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Define the stock material and coordinate setup." Foreground="#666" Margin="0,0,0,18"/>

            <TextBlock Text="Job Type" FontWeight="SemiBold"/>
            <RadioButton x:Name="RbSingle" Content="Single Sided" IsChecked="True" GroupName="JobType" Margin="0,4,0,0"/>
            <RadioButton x:Name="RbDouble" Content="Double Sided" GroupName="JobType" Margin="0,4,0,0" Checked="JobType_Changed" Unchecked="JobType_Changed"/>
            <RadioButton x:Name="RbRotary" Content="Rotary" GroupName="JobType" Margin="0,4,0,0"/>

            <StackPanel x:Name="DualSidedOptions" Margin="18,8,0,0" Visibility="Collapsed">
                <TextBlock Text="Flip direction" FontSize="11" Foreground="#555"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <RadioButton x:Name="RbFlipVertical" Content="Left-to-right (mirror X)" IsChecked="True" GroupName="FlipAxis"/>
                    <RadioButton x:Name="RbFlipHorizontal" Content="Front-to-back (mirror Y)" GroupName="FlipAxis" Margin="16,0,0,0"/>
                </StackPanel>
                <CheckBox x:Name="ChkRegistrationHoles" Content="Add registration holes for re-alignment" IsChecked="True" Margin="0,6,0,0"/>
                <TextBlock x:Name="DualSidedNote" Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>

            <TextBlock Text="Size" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Width (X)" FontSize="11" Foreground="#555"/>
                    <TextBox x:Name="TxtWidth" Text="12.0" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Height (Y)" FontSize="11" Foreground="#555"/>
                    <TextBox x:Name="TxtHeight" Text="24.0" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Thickness (Z)" FontSize="11" Foreground="#555"/>
                    <TextBox x:Name="TxtThickness" Text="0.75" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Units" FontWeight="SemiBold" Margin="0,14,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <RadioButton x:Name="RbInches" Content="Inches" IsChecked="True" GroupName="Units"/>
                <RadioButton x:Name="RbMm" Content="Millimeters" GroupName="Units" Margin="16,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Material" FontWeight="SemiBold" Margin="0,14,0,0"/>
            <ComboBox x:Name="CmbMaterial" Margin="0,4,0,0" SelectedIndex="0">
                <ComboBoxItem Content="Pine"/>
                <ComboBoxItem Content="Oak"/>
                <ComboBoxItem Content="MDF"/>
                <ComboBoxItem Content="Plywood"/>
                <ComboBoxItem Content="Acrylic"/>
                <ComboBoxItem Content="Aluminum 6061"/>
                <ComboBoxItem Content="Steel"/>
            </ComboBox>

            <TextBlock Text="Z Zero Position" FontWeight="SemiBold" Margin="0,14,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <RadioButton x:Name="RbZSurface" Content="Material Surface" IsChecked="True" GroupName="ZZero"/>
                <RadioButton x:Name="RbZBed" Content="Machine Bed" GroupName="ZZero" Margin="16,0,0,0"/>
            </StackPanel>

            <Button x:Name="BtnCreateJob" Content="Create Job" FontWeight="Bold" Padding="18,10" Margin="0,24,0,0"
                    HorizontalAlignment="Left" Background="#3D7EFF" Foreground="White" BorderThickness="0" Click="BtnCreateJob_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
