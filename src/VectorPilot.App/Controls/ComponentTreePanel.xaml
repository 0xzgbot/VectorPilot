<UserControl x:Class="VectorPilot.App.Controls.ComponentTreePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Components" FontWeight="Bold" Margin="0,0,0,6"/>

        <ListBox Grid.Row="1" x:Name="ComponentList" SelectionChanged="ComponentList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding Visible}" VerticalAlignment="Center" Tag="{Binding}"
                                  Checked="Visible_Changed" Unchecked="Visible_Changed"/>
                        <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" Width="110"/>
                        <TextBlock Text="{Binding CombineMode}" Foreground="#777" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Mode" VerticalAlignment="Center" Width="52"/>
                <ComboBox x:Name="ModePicker" Width="140" SelectionChanged="Mode_Changed"/>
            </StackPanel>
            <!-- H-303: per-component dynamic modifiers (scale → tilt → fade), applied at
                 composite time by ComponentModifierEngine. The stored grid stays pristine. -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Height ×" VerticalAlignment="Center" Width="52"
                           ToolTip="Scale the selected component's heights before compositing"/>
                <Slider x:Name="HeightScaleSlider" Width="100" Minimum="0" Maximum="3" Value="1"
                        ValueChanged="ComponentModifier_Changed"/>
                <TextBox x:Name="TxtHeightScale" Width="34" Height="22" Margin="4,0,0,0" Text="1.00"
                         LostFocus="HeightScale_TextCommitted" KeyDown="HeightScale_TextCommitted"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Fade" VerticalAlignment="Center" Width="52"
                           ToolTip="Fade the component's height toward the base along a direction"/>
                <ComboBox x:Name="FadeDirectionPicker" Width="94" SelectionChanged="ComponentModifier_Changed"/>
                <Slider x:Name="FadeAmountSlider" Width="80" Minimum="0" Maximum="1" Value="0"
                        Margin="4,0,0,0" ValueChanged="ComponentModifier_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="▲" Width="30" Height="24" Click="MoveUp_Click" ToolTip="Move up (order matters)"/>
                <Button Content="▼" Width="30" Height="24" Margin="6,0,0,0" Click="MoveDown_Click"/>
                <Button Content="Remove" Width="70" Height="24" Margin="6,0,0,0" Click="Remove_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Sculpt brush" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tool" VerticalAlignment="Center" Width="52"/>
                <ComboBox x:Name="ToolPicker" Width="140"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Shape" VerticalAlignment="Center" Width="52"/>
                <ComboBox x:Name="ShapePicker" Width="140" SelectionChanged="Brush_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Falloff" VerticalAlignment="Center" Width="52"/>
                <ComboBox x:Name="FalloffPicker" Width="140" SelectionChanged="Brush_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Radius" VerticalAlignment="Center" Width="52"/>
                <Slider x:Name="RadiusSlider" Width="140" Minimum="0.5" Maximum="40" Value="5" ValueChanged="Brush_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Strength" VerticalAlignment="Center" Width="52"/>
                <Slider x:Name="StrengthSlider" Width="140" Minimum="-1" Maximum="1" Value="0.5" ValueChanged="Brush_Changed"/>
            </StackPanel>
            <TextBlock x:Name="StatusLabel" Foreground="#555" FontSize="11" Margin="0,8,0,0" Text="No components"/>
        </StackPanel>
    </Grid>
</UserControl>
