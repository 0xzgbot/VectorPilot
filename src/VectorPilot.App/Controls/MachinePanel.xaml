<UserControl x:Class="VectorPilot.App.Controls.MachinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: connection + DRO + jog -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Machine Control" FontSize="20" FontWeight="Bold"/>

                <!-- Connection -->
                <Border Background="#E9ECF5" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Connection" FontWeight="SemiBold"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbPort" Grid.Column="0"/>
                            <Button x:Name="BtnConnect" Grid.Column="2" Content="Connect" Padding="14,6" Click="BtnConnect_Click"/>
                        </Grid>
                        <TextBlock x:Name="ConnState" FontSize="11" Margin="0,4,0,0" Foreground="#B45400"/>
                    </StackPanel>
                </Border>

                <!-- DRO -->
                <Border Background="#14141C" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="STATE" FontSize="10" Foreground="#6688CC"/>
                            <TextBlock x:Name="DroState" Text="—" FontSize="22" FontWeight="Bold" Foreground="#FFB454"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="MPOS" FontSize="10" Foreground="#6688CC"/>
                            <TextBlock x:Name="DroMpos" Text="—" FontSize="15" Foreground="#E8E8F0" FontFamily="Consolas"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="WPOS" FontSize="10" Foreground="#6688CC"/>
                            <TextBlock x:Name="DroWpos" Text="—" FontSize="15" Foreground="#E8E8F0" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FEED / SPINDLE" FontSize="10" Foreground="#6688CC"/>
                            <TextBlock x:Name="DroFs" Text="—" FontSize="12" Foreground="#9AC8FF" FontFamily="Consolas"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="BUFFER" FontSize="10" Foreground="#6688CC"/>
                            <TextBlock x:Name="DroBuf" Text="—" FontSize="12" Foreground="#9AC8FF" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </Border>

                <!-- Jog -->
                <Border Background="#E9ECF5" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Jog" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Step:" VerticalAlignment="Center" Foreground="#555"/>
                            <ComboBox x:Name="CmbStep" SelectedIndex="2" Width="110" Margin="6,0,0,0">
                                <ComboBoxItem Content="Continuous"/>
                                <ComboBoxItem Content="1.0"/>
                                <ComboBoxItem Content="0.1"/>
                                <ComboBoxItem Content="0.01"/>
                                <ComboBoxItem Content="0.001"/>
                            </ComboBox>
                            <TextBlock Text="Feed:" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555"/>
                            <TextBox x:Name="TxtJogFeed" Text="200" Width="60" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="1" Content="Y+" Click="JogYPlus" FontWeight="Bold"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="Y−" Click="JogYMinus" FontWeight="Bold" Margin="0,6,0,0"/>
                            <Button Grid.Row="1" Grid.Column="0" Content="X−" Click="JogXMinus" FontWeight="Bold" Margin="0,0,6,0"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="X+" Click="JogXPlus" FontWeight="Bold" Margin="6,0,0,0"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="Z−" Click="JogZMinus" FontWeight="Bold" Margin="6,0,6,0" Background="#3D7EFF" Foreground="White" BorderThickness="0"/>
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,10,0,0">
                            <Button Content="Home $H" Click="BtnHome" Margin="0,0,4,0" Padding="8,6"/>
                            <Button Content="Zero XY" Click="BtnZeroXY" Margin="4,0" Padding="8,6"/>
                            <Button Content="Zero Z" Click="BtnZeroZ" Margin="4,0" Padding="8,6"/>
                            <Button Content="Unlock $X" Click="BtnUnlock" Margin="0,6,4,0" Padding="8,6"/>
                            <Button Content="Spindle On" Click="BtnSpindleOn" Margin="4,6,4,0" Padding="8,6" Background="#2E7D32" Foreground="White" BorderThickness="0"/>
                            <Button Content="Spindle Off" Click="BtnSpindleOff" Margin="4,6,0,0" Padding="8,6" Background="#B71C1C" Foreground="White" BorderThickness="0"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Stream -->
                <Border Background="#E9ECF5" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Stream" FontWeight="SemiBold"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGcodePath" Grid.Column="0" IsReadOnly="True" Text="No file loaded"/>
                            <Button x:Name="BtnLoad" Grid.Column="2" Content="Load G-code…" Click="BtnLoad_Click"/>
                        </Grid>
                        <ProgressBar x:Name="StreamProgress" Height="14" Margin="0,8,0,0" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="StreamInfo" FontSize="11" Foreground="#555" Margin="0,4,0,0" Text="0 / 0 lines"/>
                        <UniformGrid Columns="4" Margin="0,8,0,0">
                            <Button x:Name="BtnStart" Content="▶ Start" Click="StreamStart_Click" FontWeight="Bold" Padding="8,6" Margin="0,0,4,0" Background="#2E7D32" Foreground="White" BorderThickness="0"/>
                            <Button x:Name="BtnPause" Content="⏸ Pause" Click="StreamPause_Click" Padding="8,6" Margin="4,0"/>
                            <Button x:Name="BtnResume" Content="▶ Resume" Click="StreamResume_Click" Padding="8,6" Margin="4,0"/>
                            <Button x:Name="BtnStop" Content="⏹ Stop" Click="StreamStop_Click" Padding="8,6" Margin="4,0,0,0" Background="#B71C1C" Foreground="White" BorderThickness="0"/>
                        </UniformGrid>
                        <!-- Safety chrome: ALWAYS enabled, never gated on connection or stream state. -->
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button x:Name="BtnEStop" Content="■ E-STOP" Click="EStop_Click" IsEnabled="True"
                                    FontWeight="Bold" FontSize="14" Padding="8,10" Margin="0,0,4,0"
                                    Background="#C62828" Foreground="White" BorderThickness="0"
                                    ToolTip="Feed hold + cancel stream. Always available."/>
                            <Button x:Name="BtnReset" Content="⟲ Reset" Click="Reset_Click" IsEnabled="True"
                                    FontWeight="Bold" Padding="8,10" Margin="4,0,0,0"
                                    Background="#455A64" Foreground="White" BorderThickness="0"
                                    ToolTip="GRBL soft reset (Ctrl-X). Always available."/>
                        </UniformGrid>
                        <CheckBox x:Name="ConsoleToggle" Content="Raw TX/RX console" IsChecked="True"
                                  Margin="0,10,0,0"/>
                        <TextBlock Text="⚠ Software is not a substitute for a hardware e-stop. E-STOP and Reset are always available in this panel."
                                   FontSize="10" Foreground="#B45400" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT: console -->
        <Border Grid.Column="2" Background="#0E0E14" CornerRadius="6" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Console — raw TX/RX" Foreground="#9AC8FF" FontSize="11" Margin="0,0,0,6"/>
                <ScrollViewer x:Name="ConsoleScroller" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ConsoleText" FontFamily="Consolas" FontSize="11" Foreground="#C8D8E8" Text="(connect to begin)"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
