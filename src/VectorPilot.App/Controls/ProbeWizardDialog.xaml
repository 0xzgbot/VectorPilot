<Window x:Class="VectorPilot.App.Controls.ProbeWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z Touch-Plate Probe" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PanelBg}">
    <StackPanel Margin="16">
        <TextBlock Text="Touch-plate Z probe" FontSize="17" FontWeight="Bold"/>
        <TextBlock Text="Park the tool above the plate, clamp it to the stock, then probe.&#x0a;On contact, work zero is set so Z0 = stock top."
                   Foreground="#777" Margin="0,4,0,12"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Plate thickness mm:" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtPlateThickness" Text="10" Margin="0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Probe target Z (travel):" VerticalAlignment="Center" Margin="0,4"
                       ToolTip="How far below the current position the probe may travel before giving up"/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtTargetZ" Text="-15" Margin="0,4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Probe feed mm/min:" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtFeed" Text="100" Margin="0,4"/>
        </Grid>

        <Button x:Name="BtnProbe" Content="Probe now (G38.2)" Height="32" Margin="0,14,0,0"
                Click="Probe_Click" FontWeight="Bold"/>
        <ProgressBar x:Name="ProbeBar" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0"/>
        <TextBlock x:Name="ResultLabel" Foreground="#8888A0" Margin="0,10,0,0" TextWrapping="Wrap"
                   x:FieldModifier="public"/>

        <Button Content="Close" Width="90" Height="26" HorizontalAlignment="Right" Margin="0,14,0,0"
                Click="Close_Click"/>
    </StackPanel>
</Window>
