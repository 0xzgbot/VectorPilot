<Window x:Class="VectorPilot.App.Controls.ToolBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tool Database" Width="720" Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Material" VerticalAlignment="Center"/>
            <ComboBox x:Name="MaterialPicker" Width="130" Margin="6,0,16,0" SelectionChanged="Context_Changed"/>
            <TextBlock Text="Machine" VerticalAlignment="Center"/>
            <ComboBox x:Name="MachinePicker" Width="150" Margin="6,0,0,0" SelectionChanged="Context_Changed"/>
            <TextBlock x:Name="ResolveNote" Foreground="#666" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="ToolTree" Grid.Column="0" SelectedItemChanged="ToolTree_SelectedItemChanged"/>

            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock x:Name="ToolTitle" Text="Select a tool" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock x:Name="ToolGeom" Foreground="#555" Margin="0,0,0,14" TextWrapping="Wrap"/>

                <TextBlock Text="Cut data (for the selected material)" FontWeight="Bold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/><ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Feed (mm/min)" VerticalAlignment="Center" Margin="0,3"/>
                    <TextBox  Grid.Row="0" Grid.Column="1" x:Name="FeedBox" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Plunge (mm/min)" VerticalAlignment="Center" Margin="0,3"/>
                    <TextBox  Grid.Row="1" Grid.Column="1" x:Name="PlungeBox" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Spindle (RPM)" VerticalAlignment="Center" Margin="0,3"/>
                    <TextBox  Grid.Row="2" Grid.Column="1" x:Name="RpmBox" Margin="0,3"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Max depth (mm)" VerticalAlignment="Center" Margin="0,3"/>
                    <TextBox  Grid.Row="3" Grid.Column="1" x:Name="DepthBox" Margin="0,3"/>
                </Grid>

                <Button Content="Stage edit" Width="100" Height="26" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Stage_Click"/>
                <TextBlock x:Name="StatusNote" Foreground="#0A6" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Revert" Width="90" Height="26" Click="Revert_Click"/>
            <Button Content="Save" Width="90" Height="26" Margin="8,0,0,0" Click="Save_Click"/>
            <Button Content="Close" Width="90" Height="26" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
