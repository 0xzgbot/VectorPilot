<Window x:Class="VectorPilot.App.Controls.RecipeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New from recipe" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Start from a recipe" FontSize="16" FontWeight="Bold"/>
        <TextBlock Text="A recipe builds a complete job — stock, layers and toolpaths — ready to cut."
                   Foreground="#777" TextWrapping="Wrap" Margin="0,4,0,12"/>

        <ListBox x:Name="RecipeList" Height="130" SelectionMode="Single">
            <ListBoxItem Content="Carved sign — text on a curve, V-carved, with a border" IsSelected="True" Tag="sign"/>
            <ListBoxItem Content="Photo plaque — plaque sheet with a dome relief face (H-502)" Tag="photo-plaque"/>
            <ListBoxItem Content="3D coaster — stock with a round recess, pocket program ready" Tag="coaster"/>
            <ListBoxItem Content="Blank job — empty sheet, no toolpaths" Tag="blank"/>
        </ListBox>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sign text" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtSignText" Text="SHOP" Margin="0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Font" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="CmbFont" Margin="0,4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="V-bit angle (°)" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtAngle" Text="90" Margin="0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Carve depth (mm)" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtDepth" Text="3.0" Margin="0,4"/>
        </Grid>

        <TextBlock x:Name="Note" Foreground="#B22" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Height="26" IsCancel="True"/>
            <Button x:Name="BtnCreate" Content="Create job" Width="100" Height="26" Margin="8,0,0,0"
                    IsDefault="True" Click="Create_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
