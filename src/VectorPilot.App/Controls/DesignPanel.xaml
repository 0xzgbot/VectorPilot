<UserControl x:Class="VectorPilot.App.Controls.DesignPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E8E8EE" Padding="8" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Design" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,16,0"/>
                <RadioButton x:Name="ToolSelect" Content="Select" IsChecked="True" GroupName="Tool" VerticalAlignment="Center"/>
                <RadioButton x:Name="ToolRect" Content="Rectangle" GroupName="Tool" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <RadioButton x:Name="ToolLine" Content="Line" GroupName="Tool" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <RadioButton x:Name="ToolCircle" Content="Circle" GroupName="Tool" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <RadioButton x:Name="ToolPolyline" Content="Polyline" GroupName="Tool" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <RadioButton x:Name="ToolNode" Content="Nodes" GroupName="Tool" VerticalAlignment="Center" Margin="12,0,0,0"
                             ToolTip="Click a shape to edit its points. Double-click a segment to insert. Del removes."/>
                <CheckBox x:Name="ChkShowToolpaths" Content="Show toolpaths" VerticalAlignment="Center" Margin="24,0,0,0"
                          Checked="ShowToolpaths_Changed" Unchecked="ShowToolpaths_Changed"
                          ToolTip="Overlay calculated G-code on the sheet — cut moves solid green, rapids dashed red"/>
                <TextBlock x:Name="LayerLabel" Text="" Foreground="#666" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Edit ops bar -->
        <Border Grid.Row="1" Background="#F0F0F4" Padding="6" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="UndoButton" Content="↶ Undo" Width="72" Height="24" Click="Undo_Click" ToolTip="Ctrl+Z"/>
                <Button x:Name="RedoButton" Content="↷ Redo" Width="72" Height="24" Margin="6,0,0,0" Click="Redo_Click" ToolTip="Ctrl+Y"/>
                <Separator Margin="10,0" Width="1" Background="#CCC"/>
                <Button Content="Delete" Width="64" Height="24" Click="Delete_Click" ToolTip="Del"/>
                <Button Content="Duplicate" Width="76" Height="24" Margin="6,0,0,0" Click="Duplicate_Click" ToolTip="Ctrl+D"/>
                <Button Content="Select All" Width="76" Height="24" Margin="6,0,0,0" Click="SelectAll_Click" ToolTip="Ctrl+A"/>
                <Separator Margin="10,0" Width="1" Background="#CCC"/>
                <Button Content="Flip H" Width="60" Height="24" Click="FlipH_Click"/>
                <Button Content="Flip V" Width="60" Height="24" Margin="6,0,0,0" Click="FlipV_Click"/>
                <Button x:Name="TransformButton" Content="Transform…" Width="86" Height="24" Margin="6,0,0,0" Click="Transform_Click" ToolTip="Exact X/Y/W/H, rotate, scale"/>
                <Separator Margin="10,0" Width="1" Background="#CCC"/>
                <Button x:Name="UnionButton" Content="Union" Width="60" Height="24" Click="Union_Click" ToolTip="Weld selected shapes"/>
                <Button x:Name="SubtractButton" Content="Subtract" Width="70" Height="24" Margin="6,0,0,0" Click="Subtract_Click" ToolTip="Cut later shapes out of the first"/>
                <Button x:Name="IntersectButton" Content="Intersect" Width="70" Height="24" Margin="6,0,0,0" Click="Intersect_Click" ToolTip="Keep only the overlap"/>
                <Button x:Name="TraceButton" Content="Trace bitmap…" Width="102" Height="24" Margin="6,0,0,0" Click="Trace_Click" ToolTip="Import an image and trace its outlines to vectors"/>
                <Button x:Name="KeepOutButton" Content="Keep-out" Width="72" Height="24" Margin="6,0,0,0" Click="KeepOut_Click" ToolTip="Mark the selection's bounds as a no-cut zone (clamps, hold-downs)"/>
                <Button x:Name="FrameButton" Content="Frame" Width="60" Height="24" Margin="10,0,0,0"
                        IsEnabled="False" Click="Frame_Click"
                        ToolTip="Rapid the tool around the job bounds so you can see the travel before cutting. Needs a connected machine."/>
                <Button x:Name="GroupButton" Content="Group" Width="58" Height="24" Margin="6,0,0,0" Click="Group_Click" ToolTip="Group the selection (Ctrl+G) — selecting one member selects all"/>
                <Button x:Name="UngroupButton" Content="Ungroup" Width="66" Height="24" Margin="6,0,0,0" Click="Ungroup_Click" ToolTip="Dissolve the selection's group (Ctrl+Shift+G)"/>
                <Button x:Name="GadgetButton" Content="Gadget…" Width="70" Height="24" Margin="6,0,0,0" Click="Gadget_Click" ToolTip="Generate geometry with a sandboxed Lua script"/>
                <Button x:Name="KeyholeButton" Content="Keyhole" Width="62" Height="24" Margin="4,0,0,0"
                        Click="Keyhole_Click"
                        ToolTip="Add a keyhole hanging slot from the C# gadget (undoable)"/>
                <Button x:Name="NestButton" Content="Nest" Width="52" Height="24" Margin="6,0,0,0" Click="Nest_Click" ToolTip="Pack the selected closed shapes onto the sheet (undoable)"/>
                <TextBox x:Name="TxtFilletRadius" Width="34" Height="24" Margin="6,0,0,0" Text="5"
                         ToolTip="Fillet radius / extend distance (mm)"/>
                <Button x:Name="FilletButton" Content="Fillet" Width="50" Height="24" Margin="4,0,0,0" Click="Fillet_Click" ToolTip="Round the selected shapes' corners by the radius (undoable)"/>
                <Button x:Name="ExtendButton" Content="Extend" Width="56" Height="24" Margin="4,0,0,0" Click="Extend_Click" ToolTip="Extend open paths at both ends so they meet (undoable)"/>
                <Button x:Name="ValidateButton" Content="Validate" Width="62" Height="24" Margin="6,0,0,0" Click="Validate_Click" ToolTip="Check for open vectors and self-intersections, and select the offenders"/>
                <TextBox x:Name="TxtCurveText" Width="90" Height="24" Margin="6,0,0,0"
                         ToolTip="Text to lay along the selected path"/>
                <Button x:Name="TextOnCurveButton" Content="Text on curve" Width="88" Height="24" Margin="4,0,0,0"
                        Click="TextOnCurve_Click"
                        ToolTip="Lay the text along the selected path as outlines (undoable)"/>
                <Button x:Name="FitCurvesButton" Content="Fit curves" Width="70" Height="24" Margin="6,0,0,0"
                        Click="FitCurves_Click"
                        ToolTip="Smooth the selected polylines, keeping sharp corners (undoable)"/>
                <ComboBox x:Name="CmbTexture" Width="86" Height="24" Margin="6,0,0,0" SelectedIndex="0"
                          ToolTip="Texture pattern">
                    <ComboBoxItem Content="Crosshatch"/>
                    <ComboBoxItem Content="Dots"/>
                    <ComboBoxItem Content="Zigzag"/>
                </ComboBox>
                <Button x:Name="TextureFillButton" Content="Texture fill" Width="76" Height="24" Margin="4,0,0,0"
                        Click="TextureFill_Click"
                        ToolTip="Fill the selected CLOSED shapes with a repeating pattern (undoable)"/>
                <TextBlock x:Name="ValidateLabel" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" Foreground="#B22"/>
                <Separator Margin="10,0" Width="1" Background="#CCC"/>
                <ComboBox x:Name="CmbViewPreset" Width="132" Height="24" ToolTip="View presets"
                          SelectionChanged="ViewPreset_Changed"/>
                <Button Content="Fit" Width="48" Height="24" Margin="6,0,0,0" Click="Fit_Click" ToolTip="Fit sheet in view"/>
                <TextBlock x:Name="SelectionLabel" Text="" Foreground="#555" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F4F4F6" BorderBrush="#CCC" BorderThickness="1" Margin="8,8,0,8" Padding="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="＋" Width="28" Height="24" Click="AddLayer_Click" ToolTip="Add layer"/>
                        <Button Content="🗑" Width="28" Height="24" Margin="6,0,0,0" Click="DeleteLayer_Click" ToolTip="Delete layer"/>
                    </StackPanel>
                    <TextBlock Text="Layers" FontWeight="Bold" Margin="2,0,0,6"/>
                    <ListBox x:Name="LayersList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="LayersList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Visible}" Checked="LayerToggle_Changed" Unchecked="LayerToggle_Changed" VerticalAlignment="Center" ToolTip="Visible"/>
                                    <ToggleButton IsChecked="{Binding Locked}" Content="🔒" FontSize="10" Width="20" Height="18"
                                                  Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="Lock — locked layers cannot be edited"
                                                  Checked="LayerToggle_Changed" Unchecked="LayerToggle_Changed"/>
                                    <Button Content="solo" FontSize="9" Width="30" Height="18" Margin="4,0,0,0"
                                            VerticalAlignment="Center" Click="LayerSolo_Click"
                                            Tag="{Binding Name}" ToolTip="Show only this layer (click again to show all)"/>
                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#CCC" BorderThickness="1" Margin="8">
                <Canvas x:Name="DrawCanvas" Background="White" ClipToBounds="True"
                        MouseLeftButtonDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp"
                        MouseRightButtonDown="Canvas_RightDown" MouseWheel="Canvas_MouseWheel">
                    <Canvas.RenderTransform>
                        <TransformGroup x:Name="ViewTransform">
                            <ScaleTransform x:Name="ViewScale"/>
                            <TranslateTransform x:Name="ViewOffset"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                </Canvas>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#E8E8EE" Padding="6" BorderBrush="#CCC" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" Text="Ready" Foreground="#555" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
