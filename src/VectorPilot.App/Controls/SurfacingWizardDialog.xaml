<Window x:Class="VectorPilot.App.Controls.SurfacingWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wasteboard Surfacing" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PanelBg}">
    <StackPanel Margin="16">
        <TextBlock Text="Wasteboard surfacing" FontSize="17" FontWeight="Bold"/>
        <TextBlock Text="Generates a raster facing program over the sheet XY and lands it&#x0a;in the Cuts list. Nothing moves until YOU press Start."
                   Foreground="#777" Margin="0,4,0,12"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sheet width mm:" VerticalAlignment="Center" Margin="0,3"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtSheetW" Margin="0,3"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Sheet height mm:" VerticalAlignment="Center" Margin="0,3"/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtSheetH" Margin="0,3"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Cutter diameter mm:" VerticalAlignment="Center" Margin="0,3"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtCutter" Text="22" Margin="0,3"
                       ToolTip="Typical: a 20–25mm face-mill or spoilboard cutter"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Stepover % of cutter:" VerticalAlignment="Center" Margin="0,3"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtStepover" Text="40" Margin="0,3"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Depth per pass mm:" VerticalAlignment="Center" Margin="0,3"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtDepth" Text="1" Margin="0,3"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Feed mm/min:" VerticalAlignment="Center" Margin="0,3"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="TxtFeed" Width="70" Text="800" Margin="0,3"/>
                <TextBlock Text="  RPM:" VerticalAlignment="Center" Foreground="#777"/>
                <TextBox x:Name="TxtRpm" Width="70" Text="18000" Margin="6,0,0,3"/>
            </StackPanel>
        </Grid>

        <Button Content="Generate facing program" Height="32" Margin="0,14,0,0"
                Click="Generate_Click" FontWeight="Bold"/>
        <TextBlock x:Name="ResultLabel" Foreground="#8888A0" Margin="0,10,0,0" TextWrapping="Wrap"
                   x:FieldModifier="public"/>

        <Button Content="Close" Width="90" Height="26" HorizontalAlignment="Right" Margin="0,14,0,0"
                Click="Close_Click"/>
    </StackPanel>
</Window>
