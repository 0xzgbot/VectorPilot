<UserControl x:Class="VectorPilot.App.Controls.OutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Output" FontSize="20" FontWeight="Bold"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
            <TextBlock Text="Post template:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CmbPost" Width="240" VerticalAlignment="Center"/>
            <TextBlock Text="Tile:" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="#555"/>
            <TextBox x:Name="TxtTileW" Width="52" Height="22" Margin="4,0,0,0" Text="600"
                     ToolTip="Tile width (mm)"/>
            <TextBlock Text="×" VerticalAlignment="Center" Margin="3,0"/>
            <TextBox x:Name="TxtTileH" Width="52" Height="22" Text="400" ToolTip="Tile height (mm)"/>
            <TextBlock Text="overlap" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555"/>
            <TextBox x:Name="TxtTileOverlap" Width="42" Height="22" Margin="4,0,0,0" Text="5"
                     ToolTip="Overlap between neighbouring tiles (mm)"/>
            <Button x:Name="BtnTile" Content="Export tiles" Width="92" Height="22" Margin="8,0,0,0"
                    Click="ExportTiles_Click"
                    ToolTip="Split the program into one file per tile for a job larger than the machine"/>
            <TextBlock x:Name="TxtExportInfo" Foreground="#888" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBlock x:Name="TxtTimeEstimate" Foreground="#0A6" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="ListToolpaths" Grid.Row="2" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Export .tap" Width="110" Click="ExportTap_Click"/>
            <Button Content="Export w/ template" Width="130" Margin="8,0,0,0" Click="ExportTemplate_Click"/>
            <Button Content="Job sheet (HTML)" Width="120" Margin="8,0,0,0" Click="JobSheetHtml_Click"/>
            <Button x:Name="BtnJobSheetPdf" Content="Job sheet (PDF)" Width="120" Margin="8,0,0,0" Click="JobSheetPdf_Click"/>
            <Button x:Name="BtnSimulate" Content="Simulate cut" Width="110" Margin="8,0,0,0" Click="Simulate_Click"
                    ToolTip="Sweep the G-code through the stock and report removal, coverage and cut-through"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Exports write next to the current .shoppilot job (or into Documents)." Foreground="#777" FontSize="11"/>
    </Grid>
</UserControl>
