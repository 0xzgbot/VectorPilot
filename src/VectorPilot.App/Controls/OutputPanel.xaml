<UserControl x:Class="VectorPilot.App.Controls.OutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Output" FontSize="20" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Text="Save Toolpaths and job sheets land here (post-processor engine in M4 of the port plan)." 
                   Foreground="#777" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="TxtOutputInfo" Foreground="#888" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </StackPanel>
    </Grid>
</UserControl>
