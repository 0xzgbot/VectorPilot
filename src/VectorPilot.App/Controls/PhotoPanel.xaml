<UserControl x:Class="VectorPilot.App.Controls.PhotoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: import + adjustments -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Photo" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Turn a photograph into toolpaths: V-carve engraving, a backlit lithophane, or a 3D relief."
                           Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,12"/>

                <Button x:Name="BtnImportPhoto" Content="Import photo…" Height="30" Padding="10,0"
                        HorizontalAlignment="Left" Click="ImportPhoto_Click"/>

                <TextBlock x:Name="PhotoStatus" Text="no image loaded" Foreground="#555" Margin="0,8,0,0"/>

                <StackPanel x:Name="AdjustPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Contrast" Foreground="#555"/>
                    <Slider x:Name="SldContrast" Minimum="0.2" Maximum="3" Value="1" TickFrequency="0.1"
                            IsSnapToTickEnabled="False" ValueChanged="Adjust_Changed"/>
                    <TextBlock Text="Brightness" Foreground="#555" Margin="0,6,0,0"/>
                    <Slider x:Name="SldBrightness" Minimum="-0.5" Maximum="0.5" Value="0"
                            ValueChanged="Adjust_Changed"/>
                    <CheckBox x:Name="ChkInvert" Content="Invert (dark → light)" Margin="0,8,0,0"
                              Checked="Adjust_Changed" Unchecked="Adjust_Changed"/>
                    <Button x:Name="BtnCropHalf" Content="Crop to centre half" Height="26" Padding="8,0"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="Crop_Click"/>
                </StackPanel>

                <TextBlock Text="Actions" FontWeight="Bold" Margin="0,16,0,6"/>
                <Button x:Name="BtnPhotoVCarve" Content="Photo V-carve" Height="34" Padding="10,0"
                        HorizontalAlignment="Left" IsEnabled="False" Click="PhotoVCarve_Click"
                        ToolTip="Engrave the photo as variable-depth grooves"/>
                <Button x:Name="BtnLithophane" Content="Lithophane" Height="34" Padding="10,0"
                        HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="False" Click="Lithophane_Click"
                        ToolTip="Dark = thicker: a backlit plate from this photo"/>
                <Button x:Name="BtnRelief3D" Content="3D relief from grayscale" Height="34" Padding="10,0"
                        HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="False" Click="Relief3D_Click"
                        ToolTip="Raise the photo into a 3D relief component"/>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT: live preview -->
        <Border Grid.Column="2" Background="#0E0E14" CornerRadius="6" Padding="10">
            <StackPanel>
                <TextBlock Text="Preview — updates as you adjust" Foreground="#8888A0" FontSize="11"/>
                <Image x:Name="PreviewImage" Stretch="Uniform" MinHeight="380" Margin="0,8,0,0"/>
                <TextBlock x:Name="PreviewNote" Text="" Foreground="#8888A0" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
