<Window x:Class="VectorPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VectorPilot.App.Controls"
        Title="VectorPilot — CNC Suite" Width="1400" Height="860"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PanelBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Machine dock: pinned shell strip. The machine is always on screen; E-stop,
                 Hold and Reset survive leaving the Machine stage (H-103). -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <!-- Stage rail -->
        <Border Grid.Column="0" Background="{StaticResource RailBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,18,14,10">
                    <TextBlock Text="VECTORPILOT" FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="DocTitle" Text="New Job" FontSize="11" Foreground="#8888A0" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10,6">
                    <Button Style="{StaticResource RailButton}" Tag="setup" Click="Stage_Click" Content="⚙  Setup"/>
                    <Button Style="{StaticResource RailButton}" Tag="design" Click="Stage_Click" Content="✏  Design"/>
                    <Button Style="{StaticResource RailButton}" Tag="model" Click="Stage_Click" Content="🗿  Model"/>
                    <Button Style="{StaticResource RailButton}" Click="SplitView_Click" Content="⇔  Split 2D|3D"
                            ToolTip="Show the Design (2D) and Model (3D) stages side by side"/>
                    <Button Style="{StaticResource RailButton}" Tag="photo" Click="Stage_Click" Content="🖼  Photo"/>
                    <Button Style="{StaticResource RailButton}" Tag="cut" Click="Stage_Click" Content="🛠  Toolpaths"/>
                    <Button Style="{StaticResource RailButton}" Tag="machine" Click="Stage_Click" Content="🔌  Machine"/>
                    <Button Style="{StaticResource RailButton}" Tag="output" Click="Stage_Click" Content="📤  Output"/>
                    <Button Style="{StaticResource RailButton}" Click="Tools_Click" Content="🧰  Tools"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="14,10">
                    <TextBlock Text="MODE" FontSize="9" Foreground="#6A6A80" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbUiMode" Height="24" SelectedIndex="0"
                              SelectionChanged="UiMode_Changed"
                              ToolTip="Beginner shows 8 everyday operations; Advanced shows all 28">
                        <ComboBoxItem Content="Beginner"/>
                        <ComboBoxItem Content="Advanced"/>
                    </ComboBox>
                    <Button x:Name="BtnJobStarter" Content="New job…" Height="24" Margin="0,6,0,8"
                            Click="JobStarter_Click"
                            ToolTip="Pick a starting point: Sign, Photo or 3D Relief"/>
                    <TextBlock x:Name="RailStatus" Text="disconnected" FontSize="11" Foreground="#FFB454"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Stage host. H-303: when the split is on this ContentControl holds a
             two-column Grid (2D Design | 3D Model) instead of a lone panel —
             tests still drive it by content type, not layout. -->
        <ContentControl x:Name="StageHost" Grid.Column="1" Margin="10"/>

        <!-- Job starter overlay: spans both columns, hidden until asked for. Never shown
             automatically under App.IsAutomated, or ui_verify would hang on it. -->
        <ContentControl x:Name="StarterHost" Grid.Column="0" Grid.ColumnSpan="2"
                        Visibility="Collapsed"/>
        </Grid>

        <!-- Machine dock (H-103): pinned shell strip below every stage. E-stop / Hold /
             Reset stay visible and enabled after leaving the Machine stage; no auto-start. -->
        <controls:MachineDock x:Name="MachineDock" Grid.Row="1"/>
    </Grid>
</Window>
